.env
.env.*
node_modules/
.DS_Store
agents/ai-brand-auditor/runs/

# Meeting Transcriber: never commit audio or meeting content
*.m4a
*.mp3
*.wav
*.mp4
*.mov
*.transcript.txt
*.timestamped.txt
*.notes.md
# live_transcribe.py session dirs (segments + transcripts) — timestamped only,
# so the pattern can't swallow agents/live-meeting-transcriber/
live-[0-9]*/

# SEO Performance Monitor: run outputs may contain client search data
agents/ai-brand-auditor/seo-performance-monitor/runs/

# Site Auditor: crawl corpora (may include client/competitor page text)
agents/ai-brand-auditor/site-auditor/runs/
outputs/seo/

# Python bytecode
__pycache__/
*.pyc

# scratch folder pending cleanup
_to_delete/

# MCP server: generated bundle + local deps
mcp-server/src/content.ts
mcp-server/node_modules/
mcp-server/.wrangler/

# Local-only run outputs, not for publishing
outputs/legora/
